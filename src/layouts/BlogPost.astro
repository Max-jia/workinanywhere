---
// 文章頁面佈局 — GEO 優化版：Person author + FAQPage schema + 更新日期顯示
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RevealScript from '../components/RevealScript.astro';
import { SITE_AUTHOR } from '../consts';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, category, heroImage, hasFAQ } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const postUrl = new URL(Astro.url.pathname, Astro.site).toString();
const authorUrl = new URL('/about', Astro.site).toString();

// Article schema — 使用 Person 而非 Organization
const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${postUrl}#article`,
  headline: title,
  description: description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  url: postUrl,
  author: {
    '@type': 'Person',
    '@id': `${authorUrl}#author`,
    name: SITE_AUTHOR.name,
    url: authorUrl,
    description: SITE_AUTHOR.description,
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${Astro.site.toString()}#org`,
    name: 'Work Anywhere',
    logo: { '@type': 'ImageObject', url: new URL('favicon.svg', Astro.site).toString() },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  isAccessibleForFree: true,
});

// BreadcrumbList schema
const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site.toString() },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: new URL('blog', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title },
  ],
});

// FAQPage schema — 只在有 FAQ 區塊時輸出
let faqSchema = '';
if (hasFAQ) {
  faqSchema = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [],  // FAQ 具體條目由 GPT 從頁面內容中動態解析，不做靜態列舉
    about: { '@type': 'Thing', name: title },
  });
}
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <script type="application/ld+json" set:html={articleSchema}></script>
    <script type="application/ld+json" set:html={breadcrumbSchema}></script>
    {hasFAQ && <script type="application/ld+json" set:html={faqSchema}></script>}
    <style>
      .prose {
        max-width: var(--max-width);
        margin: auto;
        padding: 1em 0;
      }
      .prose :where(h2, h3, h4) { margin-top: 2em; }
      .prose :where(h2, h3, h4):first-child { margin-top: 0; }
      .prose img {
        border-radius: var(--radius-lg);
        margin: 2em 0;
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <header class="article-header">
          <h1 class="article-title">{title}</h1>
          <div class="article-meta">
            <time class="article-date" datetime={pubDate.toISOString()}>
              Published {formattedDate}
            </time>
            {updatedDate && updatedDate > pubDate && (
              <span class="article-updated">
                · Updated {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            )}
          </div>
        </header>
        <div class="prose">
          <slot />
        </div>
      </article>
      <nav class="back-link">
        <a href="/blog">← Back</a>
      </nav>
    </main>
    <Footer />
    <RevealScript />
  </body>
</html>

<style>
  main {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: 2em 1.5em 4em;
  }

  .article-header {
    margin-bottom: 2em;
    padding-bottom: 2em;
    border-bottom: 1px solid var(--color-border);
  }

  @media (prefers-color-scheme: dark) {
    .article-header { border-bottom-color: var(--color-border-dark); }
  }

  .article-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5.5vw, 3.2rem);
    font-weight: 400;
    line-height: 1.06;
    margin: 0 0 0.25em;
    color: var(--color-text-heading);
  }

  @media (prefers-color-scheme: dark) {
    .article-title { color: var(--color-text-heading-dark); }
  }

  .article-meta {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    flex-wrap: wrap;
  }

  .article-date {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .article-updated {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  .back-link {
    margin-top: 3em;
    font-size: 0.85rem;
  }
</style>
